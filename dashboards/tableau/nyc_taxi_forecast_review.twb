      <column caption='Forecast Hour' datatype='datetime' name='[Calculation_0120599773372417]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPARSE(&quot;yyyy-MM-dd HH:mm:ss&quot;, LEFT([hour_start], 19))' />
      </column>
      <column caption='Selected Forecast Hour' datatype='boolean' name='[Calculation_0120600103936003]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_0120599773372417] = [Parameters].[Parameter 0120600137785351]' />
      </column>
      <column caption='Absolute Error' datatype='real' name='[Calculation_0120600122925060]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS([pickup_count] - [lightgbm])' />
      </column>
      <column caption='Zone Label' datatype='string' name='[Calculation_0120600122978309]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Zone] + &quot; (ID &quot; + STR([pickup_zone_id]) + &quot;)&quot;' />
      </column>
      <column caption='WMAPE' datatype='real' default-format='p0.00%' name='[Calculation_0120600123035654]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([pickup_count]) &gt; 0 THEN&#10;    SUM([Calculation_0120600122925060]) / SUM([pickup_count])&#10;END' />
      </column>
