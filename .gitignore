# Local environments and Python/tool caches
.venv/
.uv-cache/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Local secrets; retain shareable configuration templates
.env
.env.*
!.env.example
!.env.template

# Operating-system files
.DS_Store

# Reproducible input/derived data; keep data/manifest.json versioned
# Ignore dataset contents while allowing DVC metadata
data/raw/**
!data/raw/**/
!data/raw/**/*.dvc
!data/raw/**/.gitignore
data/reference/**
!data/reference/**/
!data/reference/**/*.dvc
!data/reference/**/.gitignore
data/processed/**
!data/processed/**/
!data/processed/**/*.dvc
!data/processed/**/.gitignore
data/interim/
data/external/

# Bulk generated artifacts; keep small quality reports under reports/ versioned
/artifacts/
/models/
/reports/forecasts/

# Temporary files and generated test coverage
/tmp/
.coverage
.coverage.*
htmlcov/

# Tableau local packages and extracts; version editable workbook definitions
/dashboards/tableau/*.twbx
/dashboards/tableau/**/*.twbx
/dashboards/tableau/*.hyper
/dashboards/tableau/**/*.hyper
/dashboards/tableau/*.tde
/dashboards/tableau/**/*.tde
/dashboards/tableau/**/.twbr
/dashboards/tableau/*.twbr
